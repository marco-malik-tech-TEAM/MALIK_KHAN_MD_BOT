# Railway -> your service -> Variables
# DATA_DIR=/data                 # set together with a Volume mounted at /data (keeps the WhatsApp login after redeploys)
# SESSION_ID=                    # alternative to a Volume: paste the SESSION_ID the bot sends to your WhatsApp
# WEB_PASSWORD=                  # optional: the pairing page will ask for this password
# TELEGRAM_BOT_TOKEN=            # optional: Telegram pairing (not needed, the website does it)
# OWNER_NUMBER=923001234567      # owner number(s), digits only, comma separated
# BOT_PREFIX=.
# TIMEZONE=Asia/Karachi
# YT_COOKIES_FILE=               # optional: cookies for YouTube/Instagram (see README_DOWNLOADS.md)
GOOGLE_STT_KEY=your-google-api-key
